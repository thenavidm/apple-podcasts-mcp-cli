{
  "name": "@thenavidm/apple-podcasts-mcp-cli",
  "version": "2.0.1",
  "description": "Apple Podcasts MCP server and CLI for Claude Code, Codex and AI agents. 32 tools for podcast search, chart rank tracking, listener reviews, RSS feed parsing and validation, on-device transcript search, and Apple Podcasts Connect analytics.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "apple-podcasts-mcp": "dist/index.js",
    "apple-podcasts-cli": "dist/index.js",
    "apple-podcasts-mcp-cli": "dist/npx.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "verify": "npm run typecheck && npm run build && npm test",
    "check-sync": "./deploy/check-sync.sh",
    "build:mcpb": "bash desktop-extension/build.sh"
  },
  "dependencies": {
    "@thenavidm/slipway": "^0.1.17",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Navid Moazzez (https://navid.me)",
  "homepage": "https://navid.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/apple-podcasts-mcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/apple-podcasts-mcp-cli/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "apple-podcasts",
    "podcast",
    "podcasts",
    "podcast-analytics",
    "podcast-charts",
    "itunes",
    "rss",
    "transcripts",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "windsurf",
    "anthropic",
    "ai-agents",
    "llm-tools",
    "typescript",
    "cli",
    "command-line-tool",
    "slipway",
    "mcp-cli"
  ],
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "contributors": [
    "Navid Moazzez (https://navid.me)"
  ]
}
